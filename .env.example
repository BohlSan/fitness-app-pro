# Base de desarrollo (Session pooler de Supabase, con prefijo postgresql+psycopg://)
DATABASE_URL=postgresql+psycopg://usuario:password@host:5432/postgres

# Base DISTINTA para los tests (se borran sus tablas en cada corrida)
TEST_DATABASE_URL=postgresql+psycopg://usuario:password@host:5432/postgres

# Clave para firmar los tokens. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria